{
  "name": "mortise",
  "version": "0.1.0",
  "private": true,
  "description": "Mortise — dark-timber agentic coding tool. Foundation workspace.",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "proto": "buf generate",
    "proto:check": "buf generate && git diff --exit-code daemon/gen tui/src/gen",
    "ts:check": "tsc --noEmit -p tui",
    "ts:fix": "tsc --noEmit -p tui --pretty",
    "lint:ts": "eslint tui",
    "lint:ts:fix": "eslint tui --fix",
    "format:check": "prettier --check 'tui/src/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}' 'proto/**/*.proto' '*.{md,json,yaml,yml}'",
    "format:fix": "prettier --write 'tui/src/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}' 'proto/**/*.proto' '*.{md,json,yaml,yml}'",
    "lint:go": "cd daemon && gofmt -s -l . && go vet ./... && golangci-lint run",
    "format:go": "cd daemon && gofmt -s -w .",
    "lint": "npm run lint:ts && npm run lint:go",
    "test": "cd daemon && go test ./... -count=1",
    "test:race": "cd daemon && go test ./... -count=1 -race",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protoc-gen-es": "1.10.1",
    "@bufbuild/protobuf": "1.10.1",
    "@connectrpc/protoc-gen-connect-es": "1.7.0",
    "@types/node": "^22.0.0",
    "@types/react": "18.3.31",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.0",
    "lint-staged": "^15.2.0",
    "prettier": "^3.3.0",
    "typescript": "^5.5.0"
  },
  "dependencies": {
    "@connectrpc/connect": "1.7.0",
    "ink": "^5.0.0",
    "react": "18.3.1"
  },
  "lint-staged": {
    "*.go": [
      "cd daemon && gofmt -s -w"
    ],
    "tui/src/**/*.{ts,tsx,js,jsx}": [
      "prettier --write",
      "eslint --fix --max-warnings 0"
    ],
    "daemon/**/*.go": [
      "cd daemon && gofmt -s -w"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.proto": [
      "buf format -w"
    ]
  }
}
