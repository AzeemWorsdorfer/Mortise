{
  "name": "mortise",
  "version": "0.1.0",
  "private": true,
  "description": "Mortise — dark-timber agentic coding tool. Foundation workspace.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "proto": "buf generate",
    "proto:check": "buf generate && git diff --exit-code daemon/gen tui/src/gen",
    "ts:check": "tsc --noEmit -p tui",
    "ts:fix": "tsc --noEmit -p tui --pretty",
    "lint:ts": "echo 'ESLint is disabled: @typescript-eslint does not support TypeScript 7.x. Use tsc --noEmit for type-checking.'",
    "lint:ts:fix": "echo 'ESLint is disabled: @typescript-eslint does not support TypeScript 7.x.'",
    "format:check": "prettier --check 'tui/src/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}' 'proto/**/*.proto' '*.{md,json,yaml,yml}'",
    "format:fix": "prettier --write 'tui/src/**/*.{ts,tsx,js,jsx,json,md,yaml,yml}' 'proto/**/*.proto' '*.{md,json,yaml,yml}'",
    "lint:go": "cd daemon && gofmt -s -l . && go vet ./... && golangci-lint run",
    "format:go": "cd daemon && gofmt -s -w .",
    "lint": "npm run lint:ts && npm run lint:go",
    "test": "cd daemon && go test ./... -count=1",
    "test:race": "cd daemon && go test ./... -count=1 -race",
    "tui:dev": "tsx watch tui/src/main.tsx",
    "tui:mock": "tsx tui/src/main.tsx --mock",
    "tui:start": "tsx tui/src/main.tsx",
    "tui:build": "tsc -p tui",
    "prepare": "husky || true"
  },
  "devDependencies": {
    "@bufbuild/buf": "1.72.0",
    "@bufbuild/protobuf": "1.10.1",
    "@bufbuild/protoc-gen-es": "1.10.1",
    "@connectrpc/protoc-gen-connect-es": "1.7.0",
    "@types/node": "^26.0.0",
    "@types/react": "19.2.17",
    "husky": "^9.1.0",
    "lint-staged": "^17.0.0",
    "prettier": "^3.9.0",
    "typescript": "^7.0.0"
  },
  "dependencies": {
    "@connectrpc/connect": "1.7.0",
    "@connectrpc/connect-node": "^1.7.0",
    "ink": "^7.0.0",
    "react": "19.2.8",
    "tsx": "^4.23.1"
  },
  "lint-staged": {
    "*.go": [
      "cd daemon && gofmt -s -w"
    ],
    "tui/src/!(gen)/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "tui/src/gen/**/*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "daemon/**/*.go": [
      "cd daemon && gofmt -s -w"
    ],
    "*.{ts,tsx,js,jsx}": [
      "prettier --write"
    ],
    "*.proto": [
      "buf format -w"
    ]
  }
}
